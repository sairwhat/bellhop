# Copy to .env and fill in. .env is gitignored — never commit real values.

# Get local values from: npx supabase status -o env
# Get hosted values from your Supabase project dashboard > API.

# ---------------------------------------------------------------------------
# Safe to ship to the client. These appear in the app bundle, so they must stay
# public-safe. Row Level Security is what protects data, not these keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
#
# A public prefix bundles the value into client JavaScript where anyone can read
# it. The service role key bypasses every RLS policy in the database; the AI key
# bills your account. If either leaks, rotate it immediately.
# ---------------------------------------------------------------------------

# Bypasses RLS entirely. Only ever use it in trusted server code.
SUPABASE_SERVICE_ROLE_KEY=

# Vision calls for schedule extraction and notes Q&A (milestone 3+).
ANTHROPIC_API_KEY=
